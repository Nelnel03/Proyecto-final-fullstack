            "description": "Registro público. Body: nombre, email, password (min 6).",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Prueba Postman\",\n  \"email\": \"nuevo@biomon.test\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.token) {",
                  "    pm.environment.set('token', json.token);",
                  "    if (json.user && json.user.id) pm.environment.set('userId', String(json.user.id));",
                  "  }",
                  "}"
